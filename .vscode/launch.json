{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fórum AVL (Flask local)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_local.py",
      "env": { "FLASK_DEBUG": "0" },
      "console": "integratedTerminal"
    },
    {
      "name": "Testes (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal"
    }
  ]
}
