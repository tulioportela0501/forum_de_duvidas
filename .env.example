# Copie para .env (NÃO versione). Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# --- Turso (libSQL). Deixe vazio para usar SQLite local (data/forum.db) em desenvolvimento.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Obrigatório na Vercel (protege os identificadores de sessão guardados no banco). Em dev local, se vazio, é gerado em data/.
SECRET_KEY=

# --- Opcionais
# AUTO_INIT_DB=1        # cria tabelas ao iniciar (padrão: 1 no SQLite local, 0 no Turso -> use scripts/init_db.py)
# LOCAL_DB_PATH=data/forum.db
# SESSION_MAX_AGE=28800   # duração máxima da sessão, em segundos (padrão 8 h)
# SESSION_IDLE=7200       # expira após esse tempo sem uso (padrão 2 h)
# COOKIE_SECURE=          # vazio = automático (Secure em HTTPS); 1/0 força
# CORS_ORIGINS=http://127.0.0.1:5500
PORT=5000
